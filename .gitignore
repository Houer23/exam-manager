# 虚拟环境
.venv/

# Python 缓存与产物
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 测试与覆盖率
.pytest_cache/
.coverage
htmlcov/

# 类型检查 / lint 缓存
.mypy_cache/
.ruff_cache/

# 数据目录：原始成绩单与生成的分析结果不入库，仅保留目录
data/input/*
!data/input/.gitkeep
data/output/*
!data/output/.gitkeep

# 规范表缓存
data/parsed/

# 学生名单（含考号/性别/选科等敏感信息，不入库）
data/roster/*
!data/roster/.gitkeep

# 考试条目：仅模板入库，其余（各学期考试配置）本地维护
config/exams/*
!config/exams/_template.yaml

# 班级配置：仅模板入库，其余（各学期具体配置）本地维护
config/classes/*
!config/classes/_template.yaml

# 学科配置：仅模板入库，其余（各学期_学科具体配置）本地维护
config/subjects/*
!config/subjects/_template.yaml

# 全局/图表/成绩单实际配置：仅模板/默认值入库，实际配置本地维护
config/config.yaml
config/charts/config.yaml
config/results/config.yaml

# 日志
*.log

# 编辑器与 IDE
.vscode/
.idea/
*.swp

# 操作系统
.DS_Store
Thumbs.db

# 环境变量
.env
.env.local
!.env.example

# 本地测试临时目录.pytest_tmp/
